# Voyage AI key for embeddings (voyage-3.5-lite). Prepaid; required for `zchut ingest` and `zchut ask`.
VOYAGE_API_KEY=
# Anthropic key for the answer model (Haiku by default, Sonnet behind a flag). Hard-limited in the console.
ZCHUT_ANTHROPIC_API_KEY=
# Fallback name for the same key; read only when ZCHUT_ANTHROPIC_API_KEY is unset.
ANTHROPIC_API_KEY=
# OpenRouter key for the open-weights tier (Qwen). Optional; --tier qwen-openrouter and --verifier jev.
OPENROUTER_API_KEY=
# OpenAI-compatible base URL of a self-hosted vLLM server (ends in /v1). Optional; --tier vllm.
ZCHUT_VLLM_URL=
# Bearer key for that vLLM server, if it was started with --api-key. Optional.
ZCHUT_VLLM_API_KEY=
# Telegram bot token from @BotFather. Required by the deployed webhook (`zchut bot serve`).
TELEGRAM_BOT_TOKEN=
# Random string Telegram echoes in X-Telegram-Bot-Api-Secret-Token; also derives the webhook path.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat ids allowed to use the bot; empty means everyone. `zchut notify` needs one.
TELEGRAM_ALLOWED_CHAT_IDS=
# Qdrant Cloud cluster URL. Required when config store.backend is qdrant and for `zchut store migrate`.
QDRANT_URL=
# Qdrant Cloud API key for that cluster.
QDRANT_API_KEY=
# Google Cloud project holding Firestore (sessions, runs). Required by the webhook and `cost --source firestore`.
GOOGLE_CLOUD_PROJECT=
# Google Cloud region for Cloud Run, Artifact Registry and Firestore. Used by scripts/deploy.ps1.
GOOGLE_CLOUD_REGION=europe-west1

# In a cloud environment shared with another bot, use these names so the tokens do not collide.
ZCHUT_TELEGRAM_BOT_TOKEN=
ZCHUT_TELEGRAM_ALLOWED_CHAT_IDS=
