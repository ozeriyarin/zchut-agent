  "embed": {"max_retries": 5, "max_batch_tokens": 8000, "min_interval_s": 1},
  "graph": {
    "classify_max_tokens": 200,
    "verify_max_tokens": 400,
    "condense_max_tokens": 200,
    "jev": {
      "instructions": "Decide whether every claim in state.draft is supported by state.sources.",
      "criteria": {
        "supported": "Every factual claim in the draft is stated in at least one source chunk. A paraphrase, an omitted detail or a cautious 'it depends' is still supported.",
        "unsupported": "At least one claim in the draft has no source chunk that states it, or a number, amount, date or period in it differs from the source."
      }
    }
